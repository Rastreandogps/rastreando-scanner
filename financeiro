// ─── SALVAR DESPESA ─────────────────────────
async function salvarDespesa() {
  const nome   = document.getElementById('f-nome').value.trim();
  const valor  = parseFloat(document.getElementById('f-valor').value);
  const status = document.getElementById('f-status').value;
  const tipo   = document.getElementById('f-tipo').value;
  const erroEl = document.getElementById('modal-erro');

  if(!nome || isNaN(valor) || valor <= 0) {
    erroEl.textContent = 'Preencha o nome e o valor corretamente.';
    erroEl.style.display = 'block';
    return;
  }
  erroEl.style.display = 'none';

  try {
    const res = await fetch(API_URL, {
      method: 'POST',
      body: JSON.stringify({ secret: API_SECRET, action: 'salvarDespesa', tipo, nome, valor, status })
    });
    const json = await res.json();
    if(json.ok) {
      fecharModal();
      document.getElementById('f-nome').value = '';
      document.getElementById('f-valor').value = '';
      carregarDespesas();
    } else {
      erroEl.textContent = json.error || 'Erro ao salvar.';
      erroEl.style.display = 'block';
    }
  } catch(e) {
    erroEl.textContent = 'Erro de conexão. Tente novamente.';
    erroEl.style.display = 'block';
  }
}

// ─── NAVEGAÇÃO ──────────────────────────────
let despesasCarregadas = false;
let projecaoCarregada  = false;

function showTab(id, el) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.getElementById('screen-' + id).classList.add('active');
  el.classList.add('active');
  document.getElementById('fab').style.display = id === 'despesas' ? 'flex' : 'none';

  if(id === 'despesas' && !despesasCarregadas) { carregarDespesas(); despesasCarregadas = true; }
  if(id === 'projecao' && !projecaoCarregada) { carregarProjecao(); projecaoCarregada = true; }
}

function switchDesp(tipo, btn) {
  document.querySelectorAll('.seg-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('desp-empresa').style.display = tipo === 'empresa' ? 'block' : 'none';
  document.getElementById('desp-pessoal').style.display = tipo === 'pessoal' ? 'block' : 'none';
}

function abrirModal()  { document.getElementById('modal').classList.add('open') }
function fecharModal() { document.getElementById('modal').classList.remove('open') }
function fecharModalFora(e) { if(e.target === document.getElementById('modal')) fecharModal() }

// ─── INIT ────────────────────────────────────
carregarDashboard();
</script>
